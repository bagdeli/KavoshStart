#!/bin/sh
# KavoshStart agent guard (layer A) — BR-6, BR-7, REL-3.
# Activated by `git config core.hooksPath .githooks` (KavoshStart scripts/install-agent-guards.sh).
# GitHub Free cannot protect branches server-side, so this hook is the preventive layer;
# the kavosh-main-guard workflow records anything that bypasses it.
zero=0000000000000000000000000000000000000000

is_initial_scaffold() {
  # The only allowed direct push to main: the first commit of an empty repository.
  [ "$(git rev-list --count "$1" 2>/dev/null)" = "1" ] &&
    git log -1 --format=%s "$1" | grep -q '^chore: scaffold from KavoshStart'
}

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$remote_sha" = "$zero" ] && is_initial_scaffold "$local_sha"; then
        continue
      fi
      echo "KavoshStart BR-6: pushing to $remote_ref is not allowed. Open a pull request." >&2
      exit 1 ;;
    refs/tags/v*) ;;
    refs/tags/*)
      echo "KavoshStart REL-3: only v* version tags are allowed ($remote_ref)." >&2
      exit 1 ;;
  esac
  [ "$local_sha" = "$zero" ] && continue          # deleting your own remote branch
  [ "$remote_sha" = "$zero" ] && continue         # new branch
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    case "$remote_ref" in
      refs/heads/feat/*|refs/heads/fix/*|refs/heads/docs/*|refs/heads/refactor/*|refs/heads/test/*|refs/heads/ci/*|refs/heads/chore/*|refs/heads/perf/*|refs/heads/build/*|refs/heads/hotfix/*|refs/heads/revert/*)
        echo "KavoshStart: rewriting your own short-lived branch $remote_ref (allowed; prefer --force-with-lease)." >&2 ;;
      *)
        echo "KavoshStart BR-7: force-push to $remote_ref is not allowed." >&2
        exit 1 ;;
    esac
  fi
done
exit 0
