# Copy to /etc/kavosh/{{SLUG}}/deploy.env on each server. No secrets here — secrets live in .env next to compose.yaml.
PROJECT={{SLUG}}
# test: newest tag including -rc ; production: only the version written in /etc/kavosh/{{SLUG}}/pin
CHANNEL=test
APP_DIR=/opt/kavosh/{{SLUG}}
# Read-only deploy key or mirror URL (KavoshRepo relay) — the server pulls, GitHub never pushes (DEP-1)
REPO_URL=git@github.com:{{REPO}}.git
HEALTH_URL=http://127.0.0.1:8080/version
HEALTH_TIMEOUT=90
