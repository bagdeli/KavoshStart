# Copy to /etc/kavosh/{{SLUG}}/deploy.env on each server. No secrets here — secrets live in $BASE/shared/.env.
PROJECT={{SLUG}}
BASE=/opt/kavosh/{{SLUG}}
# Must match kavosh.project.json. Standard deployer supports pull-build or pull-image.
DEPLOY_METHOD={{DEPLOY_METHOD}}
# test: newest SemVer tag including -rc ; production: exact version written in /etc/kavosh/{{SLUG}}/pin
CHANNEL=test
# Read-only deploy key or approved mirror — the server pulls, GitHub never pushes (DEP-1).
REPO_URL=git@github.com:{{REPO}}.git

# Identity and health are separate gates. VERSION_URL must return exact {"version":"vX.Y.Z[-rc.N]","sha":"<40-hex>"}.
VERSION_URL=http://127.0.0.1:8080/version
HEALTH_URL=http://127.0.0.1:8080/health
# Canonical environment origin reached through the real reverse proxy / DNS path, without a trailing slash.
# REQUIRED before enabling the persistent Test/Production timer; example: https://test.example.com
PUBLIC_BASE_URL=
HEALTH_TIMEOUT=90
KEEP_RELEASES=3

# pull-image only: REQUIRED fail-closed command proving the pulled immutable artifact belongs to KAVOSH_VERSION/KAVOSH_SHA.
# Examples are registry/signing specific; do not satisfy this by echoing environment labels.
ARTIFACT_VERIFY_CMD=

# Database projects (DEP-5, DEP-6). Leave migration settings empty if there is no database.
# MIGRATE_CMD must be idempotent and only EXPAND the schema in the same release (no drop/rename of used columns).
MIGRATE_CMD=
# expand-contract (default), or maintenance-window for an ADR-approved T1-only downtime migration.
MIGRATION_MODE=expand-contract
# Set to a command such as "docker compose -p {{SLUG}} stop" for a maintenance-window migration.
MAINTENANCE_STOP_CMD=
# These commands must fail closed; restore check verifies recent successful restore-test evidence.
BACKUP_HEALTHCHECK_CMD=
RESTORE_TEST_CHECK_CMD=
# low | high | destructive. High/destructive requires a fresh snapshot from BACKUP_CMD.
MIGRATION_RISK=low
BACKUP_CMD=
