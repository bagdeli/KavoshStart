# Copy to /etc/kavosh/{{SLUG}}/deploy.env on each server. No secrets here — secrets live in $BASE/shared/.env.
PROJECT={{SLUG}}
BASE=/opt/kavosh/{{SLUG}}
# test: newest SemVer tag including -rc ; production: only the version written in /etc/kavosh/{{SLUG}}/pin
CHANNEL=test
# Read-only deploy key or KavoshRepo mirror URL — the server pulls, GitHub never pushes (DEP-1)
REPO_URL=git@github.com:{{REPO}}.git
HEALTH_URL=http://127.0.0.1:8080/version
HEALTH_TIMEOUT=90
KEEP_RELEASES=3
# Database projects (DEP-5, DEP-6). Leave both empty if there is no database.
# MIGRATE_CMD must be idempotent and only EXPAND the schema in the same release (no drop/rename of used columns).
MIGRATE_CMD=
# BACKUP_HEALTHCHECK_CMD verifies continuous backup/PITR before every migration and must fail closed.
BACKUP_HEALTHCHECK_CMD=
# low | high | destructive. High/destructive requires a fresh snapshot from BACKUP_CMD.
MIGRATION_RISK=high
BACKUP_CMD=
