{
  "$schema": "./intake/kavosh.project.schema.json",
  "kavoshStart": "self",
  "name": "KavoshStart",
  "repo": "bagdeli/KavoshStart",
  "summary": "Engineering standard, project intake, templates and reusable GitHub workflows for every Kavosh project built by humans and AI agents.",
  "visibility": "public",
  "owner": "bagdeli",
  "tier": "T1",
  "runtime": "none",
  "firstRelease": [
    "Intake + classification",
    "Rules with enforcement",
    "Templates for T0-T2",
    "Reusable governance, main-guard and health workflows"
  ],
  "outOfScope": [
    "Product code",
    "Visual design (KavoshUI)",
    "Paid GitHub features as a requirement"
  ],
  "users": {
    "audience": "internal",
    "scale": "1-10"
  },
  "data": {
    "sensitivity": "none",
    "regulatedIntegrations": [],
    "multiTenant": false
  },
  "size": {
    "domains": 1,
    "lifetime": "years",
    "parallelStreams": 1
  },
  "ui": {
    "kind": "none",
    "kavoshui": null
  },
  "stack": {
    "languages": [
      "python",
      "bash"
    ],
    "frameworks": [
      "github-actions"
    ],
    "database": "none"
  },
  "deploy": {
    "method": "none",
    "environments": []
  },
  "ci": {
    "runner": "github-hosted",
    "monthlyMinutesBudget": 100
  },
  "limits": {
    "prMaxLines": 600,
    "maxOpenReadyPRs": 3,
    "branchMaxAgeDays": 3
  },
  "agents": [
    "claude",
    "codex"
  ]
}
