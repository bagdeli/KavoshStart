{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bagdeli/KavoshStart/intake/kavosh.project.schema.json",
  "title": "Kavosh project manifest",
  "description": "Machine-readable project profile. Read by KavoshStart workflows and agents. Stable facts only — no status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kavoshStart",
    "name",
    "repo",
    "summary",
    "visibility",
    "tier",
    "runtime",
    "users",
    "data",
    "size",
    "ui",
    "stack",
    "deploy",
    "ci",
    "agents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kavoshStart": {
      "type": "string",
      "pattern": "^v[0-9]+[.][0-9]+[.][0-9]+$",
      "description": "Exact KavoshStart release the project follows"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "visibility": {
      "enum": [
        "private",
        "public"
      ],
      "description": "Actual repository visibility. Public defaults to standard GitHub-hosted. Private runner choice follows trust, billing, network and workload; private hosted runs require a one-run workflow_dispatch authorization and a manifest never grants it."
    },
    "owner": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "T0",
        "T1",
        "T2"
      ]
    },
    "tierOverride": {
      "type": "string",
      "description": "ADR path if tier differs from CLASSIFICATION.md result"
    },
    "runtime": {
      "enum": [
        "none",
        "static",
        "server",
        "desktop"
      ]
    },
    "projectKind": {
      "enum": [
        "application",
        "library",
        "tool"
      ],
      "description": "library = consumed by other Kavosh repositories (classifies at least T1)"
    },
    "adoptionPhase": {
      "type": "boolean",
      "description": "Deprecated legacy marker. This field never authorizes enforce:false or a green report-only check."
    },
    "firstRelease": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "users": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "scale"
      ],
      "properties": {
        "audience": {
          "enum": [
            "internal",
            "customers",
            "public"
          ]
        },
        "scale": {
          "enum": [
            "1-10",
            "10-100",
            "100-1000",
            "1000+"
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitivity",
        "regulatedIntegrations",
        "multiTenant"
      ],
      "properties": {
        "sensitivity": {
          "enum": [
            "none",
            "internal",
            "personal",
            "financial"
          ]
        },
        "regulatedIntegrations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "multiTenant": {
          "type": "boolean"
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "lifetime",
        "parallelStreams"
      ],
      "properties": {
        "domains": {
          "type": "integer",
          "minimum": 1
        },
        "lifetime": {
          "enum": [
            "weeks",
            "months",
            "years"
          ]
        },
        "parallelStreams": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "web",
            "admin",
            "desktop"
          ]
        },
        "kavoshui": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^v?[0-9]+[.][0-9]+[.][0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptionADR": {
          "type": "string",
          "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$",
          "description": "ADR required when a project opts out of KavoshUI."
        }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "database": {
          "enum": [
            "postgresql",
            "sqlite",
            "mysql",
            "none"
          ]
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "environments"
      ],
      "properties": {
        "method": {
          "enum": [
            "none",
            "release-artifact",
            "pull-build",
            "pull-image",
            "custom"
          ]
        },
        "location": {
          "enum": [
            "iran",
            "abroad",
            "both"
          ]
        },
        "environments": {
          "type": "array",
          "items": {
            "enum": [
              "test",
              "production"
            ]
          }
        },
        "urls": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "authorizationADR": {
          "type": "string",
          "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$",
          "description": "Required for method=custom; proves equivalent release/security gates."
        },
        "migrationMode": {
          "enum": [
            "expand-contract",
            "maintenance-window"
          ],
          "description": "Defaults to expand-contract. maintenance-window is limited to T1 with a migration ADR and per-run owner authorization."
        },
        "migrationADR": {
          "type": "string",
          "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$"
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "monthlyMinutesBudget"
      ],
      "properties": {
        "runner": {
          "enum": [
            "self-hosted",
            "github-hosted",
            "none"
          ],
          "description": "Public defaults to standard GitHub-hosted; self-hosted on any visibility requires trustModelADR and same-repository PR gates. Private may choose hosted or isolated self-hosted. Private hosted workflow jobs run only through an owner-initiated workflow_dispatch scoped to an open PR and exact current head; manifest choice alone never authorizes shared quota."
        },
        "runnerLabels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Exact self-hosted labels for this repo: [self-hosted, linux, x64, <repo-slug>] (CI-2)"
        },
        "runners": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Capacity metric for self-hosted runners registered to this repository; size by queue and SLO, not tier."
        },
        "monthlyMinutesBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "description": "Legacy estimate only; it cannot grant authorization or stop billing. Keep zero unless separately approved for a bounded run."
        },
        "trustModelADR": {
          "type": "string",
          "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$",
          "description": "Required for any self-hosted runner; must establish rootless or disposable-VM isolation. Public use must address fork/untrusted code."
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prMaxLines": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000
        },
        "maxOpenReadyPRs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "branchMaxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "enum": [
          "claude",
          "codex",
          "copilot",
          "gemini",
          "human-only"
        ]
      },
      "minItems": 1
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
