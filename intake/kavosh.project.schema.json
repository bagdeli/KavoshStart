{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bagdeli/KavoshStart/intake/kavosh.project.schema.json",
  "title": "Kavosh project manifest",
  "description": "Machine-readable project profile. Read by KavoshStart workflows and agents. Stable facts only — no status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kavoshStart",
    "name",
    "repo",
    "summary",
    "visibility",
    "tier",
    "runtime",
    "capabilities",
    "users",
    "data",
    "size",
    "ui",
    "stack",
    "deploy",
    "ci",
    "agents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kavoshStart": {
      "type": "string",
      "pattern": "^(self|v[0-9]+[.][0-9]+[.][0-9]+)$",
      "description": "Exact KavoshStart release tag (vX.Y.Z) for consumer repositories. Reserved value 'self' is valid only for the canonical bagdeli/KavoshStart repository, which executes its checked-out source directly."
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "visibility": {
      "enum": [
        "private",
        "public"
      ],
      "description": "Actual repository visibility. Private GitHub Actions jobs use only standard GitHub-hosted runners, with owner-authorized scoped workflow_dispatch for billable runs; self-hosted is forbidden for private. Public defaults to hosted; a public self-hosted exception needs a CI-2 trust-model ADR."
    },
    "owner": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "T0",
        "T1",
        "T2"
      ]
    },
    "tierOverride": {
      "type": "string",
      "description": "ADR path if tier differs from CLASSIFICATION.md result"
    },
    "runtime": {
      "enum": [
        "none",
        "static",
        "server",
        "desktop"
      ]
    },
    "projectKind": {
      "enum": [
        "application",
        "library",
        "tool"
      ],
      "description": "library = consumed by other Kavosh repositories (classifies at least T1)"
    },
    "adoptionPhase": {
      "type": "boolean",
      "description": "Deprecated legacy migration marker. Consumers of the current standard must not set this to true; it never authorizes enforce:false."
    },
    "firstRelease": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "users": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "scale"
      ],
      "properties": {
        "audience": {
          "enum": [
            "internal",
            "customers",
            "public"
          ]
        },
        "scale": {
          "enum": [
            "1-10",
            "10-100",
            "100-1000",
            "1000+"
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitivity",
        "regulatedIntegrations",
        "multiTenant"
      ],
      "properties": {
        "sensitivity": {
          "enum": [
            "none",
            "internal",
            "personal",
            "financial"
          ]
        },
        "regulatedIntegrations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "multiTenant": {
          "type": "boolean"
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "lifetime",
        "parallelStreams"
      ],
      "properties": {
        "domains": {
          "type": "integer",
          "minimum": 1
        },
        "lifetime": {
          "enum": [
            "weeks",
            "months",
            "years"
          ]
        },
        "parallelStreams": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "web",
            "admin",
            "desktop"
          ]
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptionADR": {
          "type": "string",
          "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$",
          "description": "Approved custom UI without a pinned design-system package; includes RTL, accessibility, ownership, scope and tests."
        },
        "designSystem": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "package",
            "version"
          ],
          "properties": {
            "package": {
              "type": "string",
              "minLength": 2,
              "maxLength": 160,
              "description": "Design-system package selected by the consuming project. Never publish private provider identifiers in the public standard."
            },
            "version": {
              "type": "string",
              "pattern": "^v?[0-9]+[.][0-9]+[.][0-9]+(?:-[0-9A-Za-z.-]+)?$",
              "description": "Exact package release version; no floating ranges."
            }
          },
          "description": "Consumer-owned provider and exact pin; null requires an approved exception for UI projects."
        }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "database": {
          "enum": [
            "postgresql",
            "sqlite",
            "mysql",
            "none"
          ]
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "environments"
      ],
      "properties": {
        "method": {
          "enum": [
            "none",
            "release-artifact",
            "pull-build",
            "pull-image",
            "custom"
          ]
        },
        "location": {
          "enum": [
            "iran",
            "abroad",
            "both"
          ]
        },
        "environments": {
          "type": "array",
          "items": {
            "enum": [
              "test",
              "production"
            ]
          }
        },
        "urls": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "authorizationADR": {
          "type": "string",
          "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$",
          "description": "Required for method=custom; proves equivalent release/security gates."
        },
        "migrationMode": {
          "enum": [
            "expand-contract",
            "maintenance-window"
          ],
          "description": "Defaults to expand-contract. maintenance-window is limited to T1 with a migration ADR and per-run owner authorization."
        },
        "migrationADR": {
          "type": "string",
          "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$"
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "monthlyMinutesBudget"
      ],
      "properties": {
        "runner": {
          "enum": [
            "self-hosted",
            "github-hosted",
            "none"
          ],
          "description": "PRIVATE: ci.runner=none only at every tier/runtime; no GitHub Actions or runners of any kind. AI offers commands; only human owner executes them from a trusted GitHub-connected computer. PUBLIC: hosted default; self-hosted exception needs ADR."
        },
        "runnerLabels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Only applies to approved PUBLIC self-hosted runner; forbidden in PRIVATE."
        },
        "runners": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Approved PUBLIC self-hosted capacity only; forbidden in PRIVATE."
        },
        "monthlyMinutesBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "description": "PRIVATE: 0 mandatory. PUBLIC: accounting hint, never approval for paid work."
        },
        "trustModelADR": {
          "type": "string",
          "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$",
          "description": "Approved PUBLIC self-hosted exception only; cannot override no-Actions rule for PRIVATE."
        },
        "requiredWorkflow": {
          "type": "string",
          "pattern": "^[.]github/workflows/[A-Za-z0-9._-]+[.]ya?ml$",
          "description": "Relevant only to public Actions projects. Private local-command-only projects have no GitHub Actions workflows."
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prMaxLines": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000,
          "description": "Deprecated compatibility field. KavoshStart v2 does not use line/file counts as a merge gate; remove on normal upgrade."
        },
        "maxOpenReadyPRs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "branchMaxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "enum": [
          "claude",
          "codex",
          "copilot",
          "gemini",
          "human-only"
        ]
      },
      "minItems": 1
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "continuous"
          ],
          "description": "Continuous release-scope acceptance/evidence flow. Required for T2 when adopting/upgrading to the current KavoshStart standard."
        },
        "assurance": {
          "enum": [
            "attested",
            "risk-based"
          ],
          "description": "Optional future-release assurance. Missing means strict attested. Risk-based verifies CI-only low/medium scope items with native source-bound checks; high/critical, deferrals, and specialist evidence require independent attestation."
        }
      },
      "description": "T2 continuous acceptance; attested is the legacy default if assurance is absent. Opt-in risk-based does not waive source, test or high-risk controls."
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "release-please",
            "changesets",
            "custom"
          ],
          "description": "Release implementation strategy. This is an adapter choice, not the release safety contract; all strategies must preserve REL-1/2/5/6."
        },
        "strategyADR": {
          "type": "string",
          "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$",
          "description": "Required for changesets/custom strategies; proves equivalent SemVer, vX.Y.Z immutable tag, exact-source provenance and release gating."
        },
        "workflow": {
          "type": "string",
          "pattern": "^[.]github/workflows/[A-Za-z0-9._-]+[.]ya?ml$",
          "description": "Release workflow adapter. Defaults to .github/workflows/release.yml for release-please; required for non-default release strategies."
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "paths"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "Repository-owned shell command that prepares and builds release assets. Required for release-please artifact packaging when automation.interface is not make; Make consumers may use the default make setup + make package adapter."
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
                "description": "Relative glob under the repository checkout. Absolute paths and parent traversal are forbidden."
              },
              "description": "One or more relative globs whose regular files are attached to the GitHub Release."
            }
          },
          "description": "Optional default-release artifact adapter. Non-default release strategies own their artifact process in their declared workflow/ADR."
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface"
      ],
      "properties": {
        "interface": {
          "enum": [
            "make",
            "package-scripts",
            "task-runner",
            "custom"
          ],
          "description": "Adapter exposing semantic setup/lint/test/build/check operations. The underlying language/tool is not a KavoshStart invariant."
        },
        "customADR": {
          "type": "string",
          "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "control-plane",
          "package",
          "server",
          "browser-ui",
          "desktop",
          "persistent-data",
          "migration",
          "infrastructure",
          "release-artifact",
          "regulated",
          "cms-wordpress"
        ]
      },
      "description": "Composable project capabilities. Tier controls assurance/process; runtime controls execution shape; capabilities control domain-specific applicability/evidence. Technology names are not capabilities."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "private"
          }
        },
        "required": [
          "visibility"
        ]
      },
      "then": {
        "properties": {
          "ci": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runner",
              "monthlyMinutesBudget"
            ],
            "properties": {
              "runner": {
                "const": "none"
              },
              "monthlyMinutesBudget": {
                "const": 0
              }
            },
            "description": "PRIVATE GitHub Actions are prohibited entirely. Only local owner-run git/gh/build/test/release commands. No Actions workflow or runner metadata."
          }
        },
        "required": [
          "ci"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "public"
          },
          "ci": {
            "properties": {
              "runner": {
                "const": "none"
              }
            },
            "required": [
              "runner"
            ]
          }
        },
        "required": [
          "visibility",
          "ci"
        ]
      },
      "then": {
        "properties": {
          "tier": {
            "const": "T1"
          },
          "runtime": {
            "const": "static"
          }
        },
        "required": [
          "tier",
          "runtime"
        ]
      }
    }
  ]
}
