{
  "$schema": "https://github.com/bagdeli/KavoshStart/intake/kavosh.project.schema.json",
  "kavoshStart": "vX.Y.Z",
  "name": "Example Request Service",
  "repo": "bagdeli/Example",
  "summary": "Fictional multitenant request tracker for illustration of intake and scaffold generation only.",
  "visibility": "private",
  "owner": "bagdeli",
  "tier": "T2",
  "runtime": "server",
  "firstRelease": [
    "Submit a fictional request through a REST API",
    "Read example request state",
    "Filter demo requests on an admin screen"
  ],
  "outOfScope": [
    "Real customer records",
    "Production external integrations"
  ],
  "users": {
    "audience": "internal",
    "scale": "1-10"
  },
  "data": {
    "sensitivity": "internal",
    "regulatedIntegrations": [],
    "multiTenant": true
  },
  "size": {
    "domains": 1,
    "lifetime": "years",
    "parallelStreams": 1
  },
  "ui": {
    "kind": "admin",
    "designSystem": {
      "package": "@example/ui-kit",
      "version": "1.0.0"
    },
    "locales": [
      "fa-IR"
    ]
  },
  "stack": {
    "languages": [
      "python",
      "typescript"
    ],
    "frameworks": [
      "fastapi",
      "nextjs"
    ],
    "database": "postgresql"
  },
  "deploy": {
    "method": "pull-build",
    "location": "iran",
    "environments": [
      "test",
      "production"
    ],
    "urls": {
      "test": "https://test.example.org"
    }
  },
  "ci": {
    "runner": "github-hosted",
    "monthlyMinutesBudget": 0,
    "requiredWorkflow": ".github/workflows/ci.yml"
  },
  "limits": {
    "maxOpenReadyPRs": 3,
    "branchMaxAgeDays": 3
  },
  "agents": [
    "claude",
    "codex"
  ],
  "dependsOn": [],
  "acceptance": {
    "mode": "continuous",
    "assurance": "risk-based"
  },
  "release": {
    "strategy": "release-please",
    "workflow": ".github/workflows/release.yml"
  },
  "automation": {
    "interface": "make"
  },
  "capabilities": [
    "server",
    "browser-ui",
    "persistent-data",
    "migration"
  ]
}
